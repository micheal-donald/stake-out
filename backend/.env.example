# StakeOut Bet Backend - Environment Configuration Template
# Copy this file to .env and configure with your actual values

# Application Environment
NODE_ENV=development
PORT=4000
HOST=localhost

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/stakeoutbet
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stakeoutbet
DB_USER=stakeoutbet_user
DB_PASSWORD=your_secure_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Authentication & Security
JWT_SECRET=your_super_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_key_for_socket_sessions

# M-Pesa Integration (Legacy)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Payment Module Configuration
PAYMENT_MODULE_URL=http://localhost:3001
PAYMENT_MODULE_API_KEY=your_payment_module_api_key
PAYMENT_MODULE_TIMEOUT=30000
PAYMENT_MODULE_RETRIES=3
USE_PAYMENT_MODULE=true
FALLBACK_TO_LEGACY=true

# External Services
NGROK_AUTHTOKEN=your_ngrok_auth_token_for_webhooks

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Redis Configuration (for session storage and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Game Configuration
GAME_MIN_BET=10
GAME_MAX_BET=10000
GAME_HOUSE_EDGE=0.01
GAME_MAX_MULTIPLIER=1000

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn_for_error_tracking
DATADOG_API_KEY=your_datadog_api_key

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_DEPOSITS=true
ENABLE_WITHDRAWALS=true
MAINTENANCE_MODE=false

# Security Headers
HELMET_ENABLED=true

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=1000
API_TIMEOUT=30000