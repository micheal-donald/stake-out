# Payment Module Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3737
SERVICE_NAME=payment-module

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/stakeout_payments
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=30000

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your_32_character_encryption_key
WEBHOOK_SECRET=your_webhook_secret_key

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# M-PESA CONFIGURATION
# =============================================================================
# Environment: sandbox or production
MPESA_ENVIRONMENT=sandbox

# API Credentials
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey

# API URLs (automatically set based on environment)
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
MPESA_API_URL=https://sandbox.safaricom.co.ke

# Callback Configuration
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/webhooks/mpesa/callback
MPESA_TIMEOUT_URL=https://yourdomain.com/api/payments/webhooks/mpesa/timeout

# Transaction Configuration
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE_PREFIX=STAKEOUT
MPESA_TRANSACTION_DESC=StakeOut Payment

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=payment:

# Cache TTL (Time To Live) in seconds
CACHE_TTL_TOKENS=3600
CACHE_TTL_STATUS=300
CACHE_TTL_RATES=1800

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/payment-module.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# =============================================================================
# MONITORING & HEALTH CHECK
# =============================================================================
HEALTH_CHECK_INTERVAL=30000
METRICS_PORT=9090
ENABLE_METRICS=true

# External Service Timeouts (in milliseconds)
HTTP_TIMEOUT=10000
DB_QUERY_TIMEOUT=5000
EXTERNAL_API_TIMEOUT=15000

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000
WEBHOOK_TIMEOUT=5000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_LOGGING=true
ENABLE_DETAILED_ERRORS=false
ENABLE_CORS=true
ENABLE_HELMET=true

# Provider Feature Flags
ENABLE_MPESA=true
ENABLE_STRIPE=false
ENABLE_PAYPAL=false

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable development features (only in development)
ENABLE_DEBUG_ROUTES=false
ENABLE_MOCK_PROVIDERS=false
ENABLE_TEST_MODE=false

# Mock Provider Configuration (for testing)
MOCK_MPESA_SUCCESS_RATE=0.9
MOCK_MPESA_DELAY_MS=2000

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# Security Headers
TRUST_PROXY=false
SECURE_COOKIES=true
SAME_SITE_COOKIES=strict

# SSL Configuration (for HTTPS)
SSL_CERT_PATH=
SSL_KEY_PATH=

# Process Management
GRACEFUL_SHUTDOWN_TIMEOUT=10000
KEEP_ALIVE_TIMEOUT=5000

# =============================================================================
# INTEGRATION CONFIGURATION
# =============================================================================
# Main Application Integration
MAIN_APP_URL=http://localhost:4000
MAIN_APP_API_KEY=your_main_app_api_key

# Notification Service
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_KEY=

# Analytics Service
ANALYTICS_SERVICE_URL=
ANALYTICS_SERVICE_KEY=

# =============================================================================
# BUSINESS RULES CONFIGURATION
# =============================================================================
# Payment Limits
MIN_PAYMENT_AMOUNT=10
MAX_PAYMENT_AMOUNT=300000
DEFAULT_CURRENCY=KES

# Transaction Settings
TRANSACTION_TIMEOUT_MINUTES=5
MAX_RETRY_ATTEMPTS=3
CALLBACK_PROCESSING_TIMEOUT=30000

# Supported Phone Number Formats
PHONE_NUMBER_REGEX=^254\\d{9}$
PHONE_NUMBER_FORMATS=254XXXXXXXXX,0XXXXXXXXX,+254XXXXXXXXX

# =============================================================================
# COMPLIANCE & AUDIT
# =============================================================================
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=90
PCI_COMPLIANCE_MODE=false

# Data Retention Policies
TRANSACTION_RETENTION_DAYS=2555  # 7 years
LOG_RETENTION_DAYS=90
METRICS_RETENTION_DAYS=30

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# SMS Service (for notifications)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=STAKEOUT

# Email Service (for receipts)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@stakeout.com

# Fraud Detection
FRAUD_DETECTION_ENABLED=false
FRAUD_DETECTION_API_URL=
FRAUD_DETECTION_API_KEY=

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# Load Balancing
ENABLE_STICKY_SESSIONS=true
SESSION_AFFINITY_TIMEOUT=3600000

# Circuit Breaker Pattern
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# Bulk Operations
MAX_BULK_OPERATION_SIZE=100
BULK_OPERATION_TIMEOUT=300000

# API Versioning
API_VERSION=v1
ENABLE_API_VERSIONING=true

# Documentation
ENABLE_SWAGGER_UI=true
SWAGGER_UI_PATH=/api/docs