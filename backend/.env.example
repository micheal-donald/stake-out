# StakeOut Bet Backend - Environment Configuration Template
# Copy this file to .env and configure with your actual values

# Environment variables for StakeOutBet backend
# This addresses the "Environment Variable Security - P0" task in the MVP TODO list

# === SECURITY CONFIGURATION ===
# All secret keys should be at least 32 characters long and generated using a secure random generator

# JWT Configuration - Must be at least 32 characters
JWT_SECRET=your-very-secure-jwt-secret-key-here-minimum-32-chars

# Session Configuration - Must be at least 32 characters  
SESSION_SECRET=your-very-secure-session-secret-key-here-minimum-32-chars

# Payment Module Configuration - Must be at least 32 characters
PAYMENT_MODULE_API_KEY=your-very-secure-payment-module-api-key-here-minimum-32-chars

# Bcrypt Configuration (recommended: 10-15, default 12)
BCRYPT_ROUNDS=12

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/stakeoutbet
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stakeoutbet
DB_USER=stakeoutbet_user
DB_PASSWORD=your_secure_password
# SSL Configuration for production (path to CA certificate file)
# Leave empty for development, provide path to CA cert file for production
DB_SSL_CA=
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration (for session storage and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# M-Pesa Integration (Legacy)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa/callback
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# M-Pesa Webhook Security (PRODUCTION REQUIRED)
# Comma-separated list of M-Pesa server IPs allowed to call webhook
# Get official IP ranges from Safaricom Developer Portal
# Example: MPESA_WEBHOOK_IPS=196.201.214.200,196.201.214.206,196.201.213.114
MPESA_WEBHOOK_IPS=

# === APPLICATION CONFIGURATION ===
# Application Environment
NODE_ENV=development
PORT=4000
HOST=localhost

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Email Configuration (Nodemailer with Gmail SMTP)
# IMPORTANT: Use Gmail App Password, NOT your regular Gmail password!
# How to get Gmail App Password:
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Other (Custom name)", generate password
# 4. Use the 16-character password below

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
FROM_EMAIL=your-email@gmail.com

# Alternative SMTP providers:
# - Gmail: smtp.gmail.com (port 587 or 465)
# - Outlook: smtp-mail.outlook.com (port 587)
# - Yahoo: smtp.mail.yahoo.com (port 587)
# - Custom SMTP: your-smtp-server.com (check port with provider)

# Payment Module Configuration
PAYMENT_MODULE_URL=http://localhost:3001
PAYMENT_MODULE_TIMEOUT=30000
PAYMENT_MODULE_RETRIES=3
USE_PAYMENT_MODULE=true
FALLBACK_TO_LEGACY=true

# External Services
NGROK_AUTHTOKEN=your_ngrok_auth_token_for_webhooks

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Game Configuration
GAME_MIN_BET=10
GAME_MAX_BET=10000
GAME_HOUSE_EDGE=0.01
GAME_MAX_MULTIPLIER=1000

# Monitoring & Analytics
# Get your DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Leave empty to disable Sentry
# SENTRY_DSN=

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_DEPOSITS=true
ENABLE_WITHDRAWALS=true
MAINTENANCE_MODE=false

# Security Headers
HELMET_ENABLED=true

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=1000
API_TIMEOUT=30000