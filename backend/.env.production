# StakeOut Bet Backend - Production Environment Configuration
# This file contains production-specific settings

# Application Environment
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Frontend Configuration
FRONTEND_URL=https://stakeoutbet.com

# Database Configuration (Use environment-specific values)
DATABASE_URL=${DATABASE_URL}
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20

# Authentication & Security
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=14
SESSION_SECRET=${SESSION_SECRET}

# M-Pesa Integration (Production)
MPESA_CONSUMER_KEY=${MPESA_CONSUMER_KEY}
MPESA_CONSUMER_SECRET=${MPESA_CONSUMER_SECRET}
MPESA_BUSINESS_SHORTCODE=${MPESA_BUSINESS_SHORTCODE}
MPESA_PASSKEY=${MPESA_PASSKEY}
MPESA_CALLBACK_URL=https://api.stakeoutbet.com/api/mpesa/callback
MPESA_ENVIRONMENT=production
MPESA_BASE_URL=https://api.safaricom.co.ke

# Payment Module Configuration
PAYMENT_MODULE_URL=${PAYMENT_MODULE_URL}
PAYMENT_MODULE_API_KEY=${PAYMENT_MODULE_API_KEY}
PAYMENT_MODULE_TIMEOUT=30000
PAYMENT_MODULE_RETRIES=3
USE_PAYMENT_MODULE=true
FALLBACK_TO_LEGACY=true

# Logging Configuration
LOG_LEVEL=warn
LOG_FILE=/var/log/stakeoutbet/app.log
LOG_MAX_SIZE=50m
LOG_MAX_FILES=10

# Redis Configuration
REDIS_URL=${REDIS_URL}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# Rate Limiting (More restrictive in production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# CORS Configuration
CORS_ORIGIN=https://stakeoutbet.com
CORS_CREDENTIALS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=10000

# Game Configuration
GAME_MIN_BET=10
GAME_MAX_BET=50000
GAME_HOUSE_EDGE=0.01
GAME_MAX_MULTIPLIER=1000

# Monitoring & Analytics
SENTRY_DSN=${SENTRY_DSN}
DATADOG_API_KEY=${DATADOG_API_KEY}

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_DEPOSITS=true
ENABLE_WITHDRAWALS=true
MAINTENANCE_MODE=false

# Security Headers
HELMET_ENABLED=true

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=500
API_TIMEOUT=15000