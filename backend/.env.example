# StakeOut Bet Backend Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/stakeout_bet

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=4000
NODE_ENV=development

# M-Pesa Configuration (Legacy)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_API_URL=https://sandbox.safaricom.co.ke

# Payment Module Integration Configuration
USE_PAYMENT_MODULE=true
FALLBACK_TO_LEGACY=true
PAYMENT_MODULE_URL=http://localhost:3737
PAYMENT_MODULE_API_KEY=your_payment_module_api_key_here
PAYMENT_MODULE_TIMEOUT=30000

# Ngrok Configuration (for local webhook testing)
NGROK_AUTHTOKEN=your_ngrok_auth_token